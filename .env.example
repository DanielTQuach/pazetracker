GOOGLE_MAPS_API_KEY=
# Server-side Places — do not restrict key to HTTP referrers (see README)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API=
CLERK_JWT_KEY=
APP_ORIGIN=http://localhost:5173

# Postgres (Railway: copy the public or private DATABASE_URL)
# Without this, the server uses local JSON/ndjson under data/
DATABASE_URL=
# Set to false for local Postgres without SSL (default: SSL on for non-localhost URLs)
# DATABASE_SSL=false

# Redis (Railway: + New → Database → Redis, then reference REDIS_URL on the app)
# Without this, rate limits use in-memory counters (single instance only)
REDIS_URL=
